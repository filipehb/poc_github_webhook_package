# Webhook listener (este repositorio: poc_github_webhook_package)
PORT=3000
WEBHOOK_SECRET=seu-secret-compartilhado-com-github

# Filtros do evento Package / registry_package (checkin-discord-bot-v1)
PACKAGE_OWNER=Coletivo-Popular-Design-Desenvolvimento
PACKAGE_NAME=checkin-discord-bot-v1
IMAGE_TAG=latest

# Deploy na droplet: compose do bot (sem o servico webhook em Go)
COMPOSE_CWD=/opt/checkin-discord-bot-v1/deploy
COMPOSE_SERVICE=app

# GHCR (so se o package for privado)
GHCR_USERNAME=
GHCR_TOKEN=

# Mac Apple Silicon (teste local): descomente
# DOCKER_PLATFORM=linux/amd64
