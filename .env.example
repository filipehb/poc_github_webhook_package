# Webhook listener. Copie para /opt/github-webhook/.env
HOST=127.0.0.1
PORT=3000
WEBHOOK_SECRET=o-mesmo-secret-do-webhook-no-github

# Só dispara deploy deste pacote e desta tag.
# Produção: latest. Homologação: homol.
PACKAGE_OWNER=Coletivo-Popular-Design-Desenvolvimento
PACKAGE_NAME=checkin-discord-bot-v1
IMAGE_TAG=latest

# Pasta do repositório do bot na droplet (compose.yml fica aqui).
BOT_DIR=/opt/checkin-discord-bot-v1
BOT_ENV_FILE=/opt/checkin-discord-bot-v1/.env

# Imagem usada na primeira subida manual. No webhook, a tag publicada prevalece.
DOCKER_IMAGE=ghcr.io/coletivo-popular-design-desenvolvimento/checkin-discord-bot-v1:latest

# Preencha só se o pacote no GHCR for privado.
GHCR_USERNAME=
GHCR_TOKEN=
